{
  "name": "purr-code",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code purrs while working — hook adapter, CLI, and player daemon",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugin-marketplace"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "bin": {
    "purrcode": "./dist/cli.js",
    "purrcode-hook": "./dist/hook.js",
    "purrcode-daemon": "./dist/daemon/entry.js"
  },
  "optionalDependencies": {
    "@purrcode/sidecar-linux-x64": "workspace:*",
    "@purrcode/sidecar-darwin-arm64": "workspace:*",
    "@purrcode/sidecar-darwin-x64": "workspace:*",
    "@purrcode/sidecar-win32-x64": "workspace:*"
  }
}
