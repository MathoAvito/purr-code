{
  "name": "purr-code",
  "version": "0.0.0",
  "description": "Claude Code purrs while working — hook adapter, CLI, and player daemon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathoAvito/purr-code.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MathoAvito/purr-code#readme",
  "bugs": "https://github.com/MathoAvito/purr-code/issues",
  "keywords": [
